# Copy to .env (which is NOT committed). Never put real values here.
# Used only by the trusted backend; the isolated executor never receives them.

VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
# Optional. Reasoning models need a larger token budget than the default (2000) to finish a plan.
# VULTR_INFERENCE_MAX_TOKENS=8000
# VULTR_INFERENCE_TIMEOUT_SECONDS=120

SF_LOGIN_URL=
SF_API_VERSION=68.0
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_AGENT_ID=


# Internal web API. Generate a strong token (at least 32 random characters); never commit the value.
ACTION_GUARD_API_TOKEN=
SF_METADATA_PATH=/app/metadata.json
ACTION_GUARD_DATA_DIR=/app/runs/web
# true blocks real execution on the server (public demo). Required by infra/start.py: set true or false explicitly.
ACTION_GUARD_DEMO_MODE=true
