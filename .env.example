# Copie para .env (que NAO vai para o git). Nunca coloque valores reais aqui.
# Usadas somente pelo backend confiavel; o executor isolado nunca as recebe.

VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

SF_LOGIN_URL=
SF_API_VERSION=68.0
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_AGENT_ID=


# Interface/API interna. Gere um token forte; nunca versione o valor.
ACTION_GUARD_API_TOKEN=
SF_METADATA_PATH=/app/metadata.json
ACTION_GUARD_DATA_DIR=/app/runs/web
