      },
      {
        "object": "Task",
        "fields": [
          "Subject",
          "WhatId",
          "OwnerId",
          "Status",
          "CreatedDate"
        ]
      }
    ]
  },
  "async_window": {
    "max_wait_seconds": 30,
    "poll_interval_seconds": 5
  },
  "checks": [
    {
