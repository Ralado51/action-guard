{
  "schema_version": "1.0",
  "plan_id": "plan-close-case-001",
  "plan_version": 1,
  "plan_hash": "sha256:9056c90916d0a77d81f5caaa958c7070ce7bff5b3b523ca9c196308d6ff6214e",
  "rule_id": "rule-close-case-001",
  "approval": null,
  "preconditions": [
    {
      "id": "pre_open",
      "description": "The synthetic Case is open before the action.",
      "object": "Case",
      "field": "IsClosed",
      "expected": false
    },
    {
      "id": "pre_reason_empty",
      "description": "The closure reason is empty before the action.",
      "object": "Case",
      "field": "Closure_Reason__c",
      "expected": null
    }
  ],
  "action": {
    "executed_via": "agentforce_agent_api",
    "identifier": "Action Guard",
    "input": {
      "closure_reason": "Resolved - Customer confirmed"
    }
  },
  "monitored": {
    "objects": [
      {
        "object": "Case",
        "fields": [
          "Status",
          "OwnerId",
          "Closure_Reason__c",
          "ClosedDate",
          "IsClosed",
          "Priority",
          "Subject"
        ]
      },
      {
        "object": "Task",
        "fields": [
          "Subject",
          "WhatId",
          "OwnerId",
          "Status",
          "CreatedDate"
        ]
      }
    ]
  },
  "async_window": {
    "max_wait_seconds": 30,
    "poll_interval_seconds": 5
  },
  "checks": [
    {
      "check_id": "chk_status_closed",
      "kind": "field_equals",
      "description": "The Case was closed.",
      "object": "Case",
      "field": "Status",
      "expected": "Closed"
    },
    {
      "check_id": "chk_reason_filled",
      "kind": "field_not_empty",
      "description": "The closure reason is filled.",
      "object": "Case",
      "field": "Closure_Reason__c"
    },
    {
      "check_id": "chk_reason_matches",
      "kind": "field_equals",
      "description": "The closure reason is the one given in the plan.",
      "object": "Case",
      "field": "Closure_Reason__c",
      "expected": "Resolved - Customer confirmed"
    },
    {
      "check_id": "chk_owner_unchanged",
      "kind": "field_unchanged",
      "description": "The Case owner did not change.",
      "object": "Case",
      "field": "OwnerId"
    },
    {
      "check_id": "chk_followup_task",
      "kind": "record_created",
      "description": "Exactly one new follow-up Task, with the expected Subject, was created and linked to the Case.",
      "object": "Task",
      "link_field": "WhatId",
      "expected_count": 1,
      "match": {
        "Subject": "Action Guard - Case closure follow-up"
      }
    },
    {
      "check_id": "chk_no_unexpected",
      "kind": "no_unexpected_change",
      "description": "No other monitored field changed.",
      "object": "*",
      "allowed_changes": [
        "Case.Status",
        "Case.Closure_Reason__c",
        "Case.ClosedDate",
        "Case.IsClosed"
      ]
    }
  ]
}
