      "object": "Task",
      "link_field": "WhatId",
      "expected_count": 1,
      "match": {
        "Subject": "Action Guard - Case closure follow-up"
      }
    },
    {
      "check_id": "chk_no_unexpected",
      "kind": "no_unexpected_change",
      "description": "Nenhum outro campo monitorado mudou.",
